{
  "monitoredFolders": [
    {
      "path": "Literature",
      "rules": [
        {
          "id": "d5d099b6-c9be-4520-9cbe-e9fe2f31873c",
          "name": "DateMove",
          "enabled": true,
          "trigger": {
            "type": "move"
          },
          "actions": [
            {
              "type": "move-to-date-subfolder",
              "params": {
                "pattern": "MM-YYYY"
              }
            }
          ],
          "conditions": {
            "type": "none",
            "conditions": [
              {
                "type": "property",
                "operator": "exists",
                "params": {
                  "property": "folderer"
                }
              }
            ]
          }
        },
        {
          "id": "6cf9f6c4-9b77-456a-b20b-8b77ad00244f",
          "name": "PropMove",
          "enabled": true,
          "trigger": {
            "type": "move"
          },
          "conditions": {
            "type": "all",
            "conditions": [
              {
                "type": "property",
                "operator": "exists",
                "params": {
                  "property": "folderer"
                }
              }
            ]
          },
          "actions": [
            {
              "type": "move-to-property-subfolder",
              "params": {
                "property": "folderer"
              }
            }
          ]
        }
      ]
    },
    {
      "path": "IntegrationTestActions",
      "rules": [
        {
          "id": "it-date-subfolder",
          "name": "Date Subfolder Rule",
          "enabled": true,
          "trigger": { "type": "create" },
          "conditions": {
            "type": "all",
            "conditions": [
              { "type": "file-name", "operator": "contains", "params": { "value": "it-date-" } }
            ]
          },
          "actions": [{ "type": "move-to-date-subfolder", "params": { "pattern": "MM-YYYY" } }]
        },
        {
          "id": "it-property-subfolder",
          "name": "Property Subfolder Rule",
          "enabled": true,
          "trigger": { "type": "move" },
          "conditions": {
            "type": "all",
            "conditions": [
              { "type": "file-name", "operator": "contains", "params": { "value": "it-prop-" } }
            ]
          },
          "actions": [{ "type": "move-to-property-subfolder", "params": { "property": "destination" } }]
        },
        {
          "id": "it-move-attachments",
          "name": "Move Attachments Rule",
          "enabled": true,
          "trigger": { "type": "move" },
          "conditions": {
            "type": "all",
            "conditions": [
              { "type": "file-name", "operator": "contains", "params": { "value": "it-attach-" } }
            ]
          },
          "actions": [{ "type": "move-attachments", "params": { "folder": "Attachments" } }]
        }
      ]
    },
    {
      "path": "IntegrationTest",
      "rules": [
        {
          "id": "it-append",
          "name": "Append Rule",
          "enabled": true,
          "trigger": { "type": "create" },
          "actions": [{ "type": "append-text", "params": { "text": "<!-- appended -->" } }]
        },
        {
          "id": "it-prepend",
          "name": "Prepend Rule",
          "enabled": true,
          "trigger": { "type": "create" },
          "actions": [{ "type": "prepend-text", "params": { "text": "<!-- prepended -->" } }]
        },
        {
          "id": "it-conditional",
          "name": "Conditional Rule",
          "enabled": true,
          "trigger": { "type": "create" },
          "conditions": {
            "type": "all",
            "conditions": [
              { "type": "file-name", "operator": "contains", "params": { "value": "tagged" } }
            ]
          },
          "actions": [{ "type": "append-text", "params": { "text": "<!-- tagged -->" } }]
        },
        {
          "id": "it-rename",
          "name": "Rename Rule",
          "enabled": true,
          "trigger": { "type": "rename" },
          "actions": [{ "type": "append-text", "params": { "text": "<!-- renamed -->" } }]
        },
        {
          "id": "it-move",
          "name": "Move Rule",
          "enabled": true,
          "trigger": { "type": "move" },
          "actions": [{ "type": "append-text", "params": { "text": "<!-- moved -->" } }]
        },
        {
          "id": "it-disabled",
          "name": "Disabled Rule",
          "enabled": false,
          "trigger": { "type": "create" },
          "actions": [{ "type": "append-text", "params": { "text": "<!-- disabled -->" } }]
        }
      ]
    }
  ]
}
