{
  "name": "folderer",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && biome lint . && npm run svelte-check",
    "fix": "biome check --write .",
    "svelte-check": "svelte-check --tsconfig tsconfig.json",
    "prepare": "husky"
  },
  "dependencies": {
    "obsidian": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.4",
    "husky": "^9.1.7",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.7",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
